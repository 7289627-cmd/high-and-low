<!-- Paste inside the <activity android:name=".MainActivity" ...> element of android/app/src/main/AndroidManifest.xml,
     next to the existing MAIN/LAUNCHER intent-filter. Replace HOST and SITE_PATH (see README.md in this folder). -->
<intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW" />
    <category android:name="android.intent.category.DEFAULT" />
    <category android:name="android.intent.category.BROWSABLE" />
    <data android:scheme="https" android:host="REPLACE_HOST" android:pathPrefix="/REPLACE_SITE_PATH" />
</intent-filter>
